[Unit]
Description=Prime P1 Compositor Authority
Requires=primed.service
After=primed.service systemd-sysusers.service systemd-user-sessions.service
Before=prime-shell.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=prime-shell
Group=prime-shell
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/prime-compositor
Environment=PRIME_COMPOSITOR_READINESS=/run/prime-compositor/readiness.json
RuntimeDirectory=prime-compositor
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/rm -f /run/prime-compositor/readiness.json
ExecStart=/usr/libexec/prime/prime-compositor
Restart=on-failure
RestartSec=1s
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=graphical.target
