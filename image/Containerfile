# syntax=docker/dockerfile:1.7

ARG PRIME_BASE_IMAGE

# Build prime-compositor inside the exact Prime Fedora substrate so Kratos does
# not need compositor development packages merely to produce the Prime image.
FROM ${PRIME_BASE_IMAGE} AS compositor-builder
ARG TARGETARCH
ENV RUSTUP_HOME=/opt/prime-rustup \
    CARGO_HOME=/opt/prime-cargo \
    PATH=/opt/prime-cargo/bin:${PATH}

RUN --mount=type=tmpfs,target=/tmp \
    set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    grep -q '^ID=fedora$' /usr/lib/os-release; \
    grep -q '^VERSION_ID=44$' /usr/lib/os-release; \
    dnf -y install \
        ca-certificates \
        curl \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        'pkgconfig(libinput)' \
        'pkgconfig(libudev)' \
        'pkgconfig(gbm)' \
        'pkgconfig(libseat)' \
        'pkgconfig(xkbcommon)' \
        'pkgconfig(wayland-server)' \
        'pkgconfig(egl)' \
        'pkgconfig(glesv2)' \
        'pkgconfig(libdrm)'; \
    test "$(rpm -q --whatprovides 'pkgconfig(libinput)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libinput-devel-1.31.3-1.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(libudev)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'systemd-devel-259.8-1.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(gbm)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'mesa-libgbm-devel-26.1.7-1.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(libseat)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libseat-devel-0.9.3-1.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(xkbcommon)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libxkbcommon-devel-1.13.1-2.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(wayland-server)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'wayland-devel-1.25.0-1.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(egl)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libglvnd-devel-1.7.0-9.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(glesv2)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libglvnd-devel-1.7.0-9.fc44.x86_64'; \
    test "$(rpm -q --whatprovides 'pkgconfig(libdrm)' --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n')" = 'libdrm-devel-2.4.134-1.fc44.x86_64'; \
    rm -rf "${RUSTUP_HOME}" "${CARGO_HOME}"; \
    mkdir -p "${RUSTUP_HOME}" "${CARGO_HOME}"; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --profile minimal --default-toolchain 1.97.1 --no-modify-path; \
    rustup component add rustfmt clippy --toolchain 1.97.1; \
    test "$(rustc --version | cut -d ' ' -f2)" = '1.97.1'; \
    dnf clean all

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN set -eux; \
    cargo metadata --locked --no-deps --format-version 1 >/dev/null; \
    cargo fmt --all -- --check; \
    cargo clippy --locked -p prime-compositor -p prime-shell --all-targets -- -D warnings; \
    cargo build --locked --release -p prime-compositor -p prime-shell; \
    test -x target/release/prime-compositor; \
    test -x target/release/prime-shell; \
    ! ldd target/release/prime-compositor | grep -q 'not found'; \
    ! ldd target/release/prime-shell | grep -q 'not found'; \
    sha256sum target/release/prime-compositor > /prime-compositor.sha256; \
    sha256sum target/release/prime-shell > /prime-shell.sha256

FROM ${PRIME_BASE_IMAGE} AS rootfs-builder

ARG TARGETARCH
RUN --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    test -x /usr/libexec/bootc-base-imagectl; \
    rm -rf /target-rootfs; \
    /usr/libexec/bootc-base-imagectl build-rootfs --manifest=standard /target-rootfs; \
    test -x /target-rootfs/usr/sbin/bootc; \
    test -x /target-rootfs/usr/bin/systemctl; \
    test -f /target-rootfs/usr/lib/os-release

# Reconstruct the Fedora root filesystem into a fresh image layer before sealing.
# Fedora 44 currently has a known directory-walk vs OCI-storage Composefs digest
# divergence. The outer build performs a provisional pass, computes the canonical
# OCI-storage digest, then rebuilds only the UKI stage with that digest.
FROM scratch AS rootfs
COPY --from=rootfs-builder /target-rootfs/ /

ARG TARGETARCH
ARG PRIME_BASE_DIGEST
ARG PRIME_GENERATION_ID
ARG PRIME_SOURCE_REVISION
ARG PRIME_CREATED_AT
ARG PRIME_BOOT_ATTEMPT_LIMIT=3

LABEL containers.bootc="1" \
      org.opencontainers.image.title="Prime OS P1 First Light" \
      org.opencontainers.image.vendor="THETECHGUY DIGITAL SOLUTIONS" \
      org.opencontainers.image.revision="${PRIME_SOURCE_REVISION}"
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

# Package installation is performed while the Fedora substrate still owns
# /usr/lib/os-release. Prime product identity replaces it only after build-time
# package operations are complete.
RUN set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    test -n "${PRIME_BASE_DIGEST}"; \
    grep -q '^ID=fedora$' /usr/lib/os-release; \
    grep -q '^VERSION_ID=44$' /usr/lib/os-release; \
    dnf -y install \
        libglvnd-egl-1.7.0-9.fc44 \
        libinput-1.31.3-1.fc44 \
        libseat-0.9.3-1.fc44 \
        libwayland-client-1.25.0-1.fc44 \
        libxkbcommon-1.13.1-2.fc44 \
        mesa-dri-drivers-26.1.7-1.fc44 \
        mesa-libEGL-26.1.7-1.fc44 \
        mesa-libgbm-26.1.7-1.fc44 \
        systemd-boot-unsigned-259.8-1.fc44 \
        systemd-ukify-259.8-1.fc44; \
    rpm -q \
        libdrm-2.4.134-1.fc44 \
        libglvnd-egl-1.7.0-9.fc44 \
        libinput-1.31.3-1.fc44 \
        libseat-0.9.3-1.fc44 \
        libwayland-client-1.25.0-1.fc44 \
        libxkbcommon-1.13.1-2.fc44 \
        mesa-dri-drivers-26.1.7-1.fc44 \
        mesa-libEGL-26.1.7-1.fc44 \
        mesa-libgbm-26.1.7-1.fc44 \
        systemd-boot-unsigned-259.8-1.fc44 \
        systemd-ukify-259.8-1.fc44; \
    if rpm -q bootupd >/dev/null 2>&1; then dnf -y remove bootupd; fi; \
    dnf clean all; \
    rm -rf \
        /run/dnf \
        /var/cache/libdnf5 \
        /var/lib/dnf/repos \
        /var/lib/dnf/system-repo.lock \
        /var/log/dnf5.log \
        /var/cache/ldconfig/aux-cache; \
    ! rpm -q bootupd >/dev/null 2>&1; \
    test ! -x /usr/bin/bootupctl; \
    test ! -x /usr/sbin/bootupctl; \
    test -x /usr/bin/ukify; \
    test -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi; \
    test -f /usr/lib/systemd/boot/efi/linuxx64.efi.stub; \
    test -x /usr/sbin/bootc; \
    test -x /usr/sbin/systemd-run

COPY image/prime-os-release /usr/lib/os-release

RUN set -eux; \
    grep -q '^ID=prime$' /usr/lib/os-release; \
    grep -q '^PRETTY_NAME="Prime OS P1 First Light"$' /usr/lib/os-release; \
    install -d -m 0755 /usr/lib/prime; \
    case "${PRIME_BASE_DIGEST}" in sha256:????????????????????????????????????????????????????????????????) ;; *) exit 1 ;; esac; \
    printf '%s\n' \
       '{' \
       '  "schema": "prime.substrate-release.v1",' \
       '  "id": "fedora",' \
       '  "version_id": "44",' \
       "  \"base_image_digest\": \"${PRIME_BASE_DIGEST}\"" \
       '}' \
       > /usr/lib/prime/substrate-release.json; \
    chmod 0444 /usr/lib/prime/substrate-release.json; \
    python3 -c 'import json; d=json.load(open("/usr/lib/prime/substrate-release.json", "r", encoding="utf-8")); assert d["schema"]=="prime.substrate-release.v1"; assert d["id"]=="fedora"; assert d["version_id"]=="44"'

RUN install -d -m 0755 /usr/libexec/prime /usr/lib/bootc/install /usr/lib/sysusers.d /usr/lib/tmpfiles.d
COPY target/release/primed /usr/libexec/prime/primed
COPY target/release/prime-recovery /usr/libexec/prime/prime-recovery
COPY --from=compositor-builder /source/target/release/prime-compositor /usr/libexec/prime/prime-compositor
COPY --from=compositor-builder /source/target/release/prime-shell /usr/libexec/prime/prime-shell
COPY image/scripts/prime-shell-session /usr/libexec/prime/prime-shell-session
COPY image/scripts/prime-first-light-witness /usr/libexec/prime/prime-first-light-witness
COPY image/sysusers/prime-shell.conf /usr/lib/sysusers.d/prime-shell.conf
COPY image/tmpfiles/prime-libx11-cache.conf /usr/lib/tmpfiles.d/prime-libx11-cache.conf
COPY image/systemd/primed.service /usr/lib/systemd/system/primed.service
COPY image/systemd/prime-compositor.service /usr/lib/systemd/system/prime-compositor.service
COPY image/systemd/prime-shell.service /usr/lib/systemd/system/prime-shell.service
COPY image/systemd/prime-first-light-witness.service /usr/lib/systemd/system/prime-first-light-witness.service
COPY image/systemd/prime-recovery.service /usr/lib/systemd/system/prime-recovery.service
COPY image/systemd/prime-recovery.target /usr/lib/systemd/system/prime-recovery.target
COPY image/bootc/10-prime.toml /usr/lib/bootc/install/10-prime.toml

RUN set -eux; \
    chmod 0755 \
        /usr/libexec/prime/primed \
        /usr/libexec/prime/prime-recovery \
        /usr/libexec/prime/prime-compositor \
        /usr/libexec/prime/prime-shell \
        /usr/libexec/prime/prime-shell-session \
        /usr/libexec/prime/prime-first-light-witness; \
    chmod 0444 /usr/lib/bootc/install/10-prime.toml /usr/lib/tmpfiles.d/prime-libx11-cache.conf; \
    grep -Fx 'd /var/cache/libX11 0755 root root - -' /usr/lib/tmpfiles.d/prime-libx11-cache.conf; \
    grep -Fx 'd /var/cache/libX11/compose 0755 root root - -' /usr/lib/tmpfiles.d/prime-libx11-cache.conf; \
    ! ldd /usr/libexec/prime/prime-compositor | grep -q 'not found'; \
    ! ldd /usr/libexec/prime/prime-shell | grep -q 'not found'; \
    test -e /usr/lib64/libEGL.so.1; \
    test -e /usr/lib64/libEGL_mesa.so.0; \
    test -e /usr/lib64/libgbm.so.1; \
    test -e /usr/lib64/libdrm.so.2; \
    test -e /usr/lib64/dri/iris_dri.so; \
    rpm -qf /usr/lib64/libEGL.so.1 | grep -Fx 'libglvnd-egl-1.7.0-9.fc44.x86_64'; \
    rpm -qf /usr/lib64/libEGL_mesa.so.0 | grep -Fx 'mesa-libEGL-26.1.7-1.fc44.x86_64'; \
    rpm -qf /usr/lib64/libgbm.so.1 | grep -Fx 'mesa-libgbm-26.1.7-1.fc44.x86_64'; \
    rpm -qf /usr/lib64/libdrm.so.2 | grep -Fx 'libdrm-2.4.134-1.fc44.x86_64'; \
    rpm -qf /usr/lib64/dri/iris_dri.so | grep -Fx 'mesa-dri-drivers-26.1.7-1.fc44.x86_64'; \
    /usr/libexec/prime/prime-compositor --help | grep -F 'Usage: prime-compositor [--probe]'; \
    systemctl enable primed.service prime-compositor.service prime-shell.service prime-first-light-witness.service; \
    systemctl set-default graphical.target; \
    systemctl mask getty@tty1.service; \
    systemctl disable bootc-fetch-apply-updates.timer >/dev/null 2>&1 || true; \
    test -f /usr/lib/systemd/system/prime-recovery.service; \
    test -f /usr/lib/systemd/system/prime-recovery.target; \
    test -L /etc/systemd/system/graphical.target.wants/prime-compositor.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-shell.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-first-light-witness.service; \
    bootc install print-configuration > /tmp/prime-install-config.json; \
    python3 -c 'import json; c=json.load(open("/tmp/prime-install-config.json")); assert c.get("bootloader") == "systemd", c'; \
    rm -f /tmp/prime-install-config.json

RUN set -eux; \
    test -n "${PRIME_GENERATION_ID}"; \
    test -n "${PRIME_SOURCE_REVISION}"; \
    test -n "${PRIME_CREATED_AT}"; \
    test "${PRIME_BOOT_ATTEMPT_LIMIT}" -gt 0; \
    case "${PRIME_BASE_DIGEST}" in sha256:????????????????????????????????????????????????????????????????) ;; *) exit 1 ;; esac; \
    printf '%s\n' \
       '{' \
       '  "schema": "prime.generation-seed.v1",' \
       "  \"generation_id\": \"${PRIME_GENERATION_ID}\"," \
       '  "channel": "LAB",' \
       "  \"created_at\": \"${PRIME_CREATED_AT}\"," \
       "  \"source_revision\": \"${PRIME_SOURCE_REVISION}\"," \
       "  \"base_image_digest\": \"${PRIME_BASE_DIGEST}\"," \
       "  \"boot_attempt_limit\": ${PRIME_BOOT_ATTEMPT_LIMIT}" \
       '}' \
       > /usr/lib/prime/generation-seed.json; \
    chmod 0444 /usr/lib/prime/generation-seed.json; \
    python3 -c 'import json; json.load(open("/usr/lib/prime/generation-seed.json", "r", encoding="utf-8"))'; \
    test -x /usr/libexec/prime/primed; \
    test -x /usr/libexec/prime/prime-recovery; \
    test -x /usr/libexec/prime/prime-compositor; \
    test -x /usr/libexec/prime/prime-shell; \
    test -x /usr/libexec/prime/prime-shell-session; \
    test -x /usr/libexec/prime/prime-first-light-witness; \
    test -f /usr/lib/sysusers.d/prime-shell.conf; \
    test -f /usr/lib/tmpfiles.d/prime-libx11-cache.conf; \
    test -L /etc/systemd/system/multi-user.target.wants/primed.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-compositor.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-shell.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-first-light-witness.service; \
    test ! -e /etc/systemd/system/timers.target.wants/bootc-fetch-apply-updates.timer; \
    bootc container lint --fatal-warnings

FROM rootfs AS split
RUN set -eux; \
    mkdir -p /kernel; \
    bootc container split-kernel-and-rootfs --rootfs / --output /kernel; \
    test "$(find /kernel -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1

FROM rootfs AS uki-tools
ARG PRIME_COMPOSEFS_DIGEST
COPY image/scripts/prepare-uki-cmdlines.py /tmp/prepare-uki-cmdlines.py
COPY image/scripts/check-uki-contract.py /tmp/check-uki-contract.py
RUN --mount=type=bind,from=split,target=/target,ro \
    --mount=type=bind,from=split,source=/kernel,target=/kernel,ro \
    set -eux; \
    mkdir -p /out; \
    kver="$(find /kernel -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | head -n1)"; \
    test -n "${kver}"; \
    test -s "/kernel/${kver}/vmlinuz"; \
    test -s "/kernel/${kver}/initramfs.img"; \
    provisional="/out/${kver}.provisional.efi"; \
    normal="/out/${kver}.efi"; \
    recovery="/out/${kver}.recovery.efi"; \
    bootc container ukify \
      --rootfs /target \
      --kernel-dir "/kernel/${kver}" \
      -- \
      --output "${provisional}"; \
    test -s "${provisional}"; \
    ukify inspect --json=short "${provisional}" > /tmp/prime-provisional-uki.json; \
    python3 /tmp/prepare-uki-cmdlines.py \
      --inspect-json /tmp/prime-provisional-uki.json \
      --normal-out /tmp/prime-normal-cmdline \
      --recovery-out /tmp/prime-recovery-cmdline \
      --composefs-digest "${PRIME_COMPOSEFS_DIGEST:-}"; \
    cp /target/usr/lib/os-release /tmp/prime-recovery-os-release; \
    sed -i \
      -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Prime OS Recovery"/' \
      -e 's/^VERSION=.*/VERSION="P1 Recovery"/' \
      -e 's/^VERSION_ID=.*/VERSION_ID="0.0"/' \
      -e 's/^VARIANT=.*/VARIANT="Recovery"/' \
      -e 's/^VARIANT_ID=.*/VARIANT_ID=recovery/' \
      /tmp/prime-recovery-os-release; \
    grep -q '^PRETTY_NAME="Prime OS Recovery"$' /tmp/prime-recovery-os-release; \
    grep -q '^VERSION_ID="0.0"$' /tmp/prime-recovery-os-release; \
    ukify build \
      --linux "/kernel/${kver}/vmlinuz" \
      --initrd "/kernel/${kver}/initramfs.img" \
      --uname "${kver}" \
      --cmdline @/tmp/prime-normal-cmdline \
      --os-release @/target/usr/lib/os-release \
      --output "${normal}"; \
    ukify build \
      --linux "/kernel/${kver}/vmlinuz" \
      --initrd "/kernel/${kver}/initramfs.img" \
      --uname "${kver}" \
      --cmdline @/tmp/prime-recovery-cmdline \
      --os-release @/tmp/prime-recovery-os-release \
      --output "${recovery}"; \
    test -s "${normal}"; \
    test -s "${recovery}"; \
    ukify inspect --json=short "${normal}" > /tmp/prime-normal-uki.json; \
    ukify inspect --json=short "${recovery}" > /tmp/prime-recovery-uki.json; \
    python3 /tmp/check-uki-contract.py \
      --provisional /tmp/prime-provisional-uki.json \
      --normal /tmp/prime-normal-uki.json \
      --recovery /tmp/prime-recovery-uki.json \
      --normal-cmdline /tmp/prime-normal-cmdline \
      --recovery-cmdline /tmp/prime-recovery-cmdline; \
    rm -f \
      "${provisional}" \
      /tmp/prime-provisional-uki.json \
      /tmp/prime-normal-uki.json \
      /tmp/prime-recovery-uki.json \
      /tmp/prime-normal-cmdline \
      /tmp/prime-recovery-cmdline \
      /tmp/prime-recovery-os-release; \
    test "$(find /out -maxdepth 1 -type f -name '*.efi' | wc -l)" -eq 2; \
    test "$(find /out -maxdepth 1 -type f -name '*.recovery.efi' | wc -l)" -eq 1

FROM split AS final
COPY --from=uki-tools /out/*.efi /boot/EFI/Linux/

RUN set -eux; \
    test "$(find /boot/EFI/Linux -maxdepth 1 -type f -name '*.efi' | wc -l)" -eq 2; \
    test "$(find /boot/EFI/Linux -maxdepth 1 -type f -name '*.recovery.efi' | wc -l)" -eq 1; \
    ! find /usr/lib/modules -type f \( -name vmlinuz -o -name initramfs.img \) -print -quit | grep -q .; \
    ! rpm -q bootupd >/dev/null 2>&1; \
    test -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi; \
    test -f /usr/lib/bootc/install/10-prime.toml; \
    bootc install print-configuration | python3 -c 'import json,sys; c=json.load(sys.stdin); assert c.get("bootloader") == "systemd", c'; \
    test -f /usr/lib/prime/generation-seed.json; \
    test -f /usr/lib/prime/substrate-release.json; \
    grep -q '^ID=prime$' /usr/lib/os-release; \
    test -x /usr/libexec/prime/primed; \
    test -x /usr/libexec/prime/prime-recovery; \
    test -x /usr/libexec/prime/prime-compositor; \
    test -x /usr/libexec/prime/prime-shell; \
    test -x /usr/libexec/prime/prime-shell-session; \
    test -x /usr/libexec/prime/prime-first-light-witness; \
    test -f /usr/lib/tmpfiles.d/prime-libx11-cache.conf; \
    test -L /etc/systemd/system/graphical.target.wants/prime-compositor.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-shell.service; \
    test -L /etc/systemd/system/graphical.target.wants/prime-first-light-witness.service; \
    test -f /usr/lib/systemd/system/prime-recovery.target; \
    test -f /usr/lib/systemd/system/prime-recovery.service
