# syntax=docker/dockerfile:1.7

ARG PRIME_BASE_IMAGE
FROM ${PRIME_BASE_IMAGE} AS rootfs-builder

ARG TARGETARCH
RUN --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    test -x /usr/libexec/bootc-base-imagectl; \
    rm -rf /target-rootfs; \
    /usr/libexec/bootc-base-imagectl build-rootfs --manifest=standard /target-rootfs; \
    test -x /target-rootfs/usr/sbin/bootc; \
    test -x /target-rootfs/usr/bin/systemctl; \
    test -f /target-rootfs/usr/lib/os-release

# Reconstruct the Fedora root filesystem into a fresh image layer before sealing.
# This avoids hashing overlay/extraction-only parent-directory metadata into the
# UKI composefs digest; bootc's installer hashes the canonical OCI storage view.
FROM scratch AS rootfs
COPY --from=rootfs-builder /target-rootfs/ /

ARG TARGETARCH
ARG PRIME_BASE_DIGEST
ARG PRIME_GENERATION_ID
ARG PRIME_SOURCE_REVISION
ARG PRIME_CREATED_AT
ARG PRIME_BOOT_ATTEMPT_LIMIT=3

LABEL containers.bootc="1" \
      org.opencontainers.image.title="Prime OS P1 First Light" \
      org.opencontainers.image.vendor="THETECHGUY DIGITAL SOLUTIONS" \
      org.opencontainers.image.revision="${PRIME_SOURCE_REVISION}"
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

RUN set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    test -n "${PRIME_BASE_DIGEST}"; \
    grep -q '^ID=fedora$' /usr/lib/os-release; \
    grep -q '^VERSION_ID=44$' /usr/lib/os-release; \
    dnf -y install \
        systemd-boot-unsigned-259.8-1.fc44 \
        systemd-ukify-259.8-1.fc44; \
    if rpm -q bootupd >/dev/null 2>&1; then dnf -y remove bootupd; fi; \
    dnf clean all; \
    rm -rf \
        /run/dnf \
        /var/cache/libdnf5 \
        /var/lib/dnf/repos \
        /var/lib/dnf/system-repo.lock \
        /var/log/dnf5.log \
        /var/cache/ldconfig/aux-cache; \
    ! rpm -q bootupd >/dev/null 2>&1; \
    test ! -x /usr/bin/bootupctl; \
    test ! -x /usr/sbin/bootupctl; \
    test -x /usr/bin/ukify; \
    test -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi; \
    test -f /usr/lib/systemd/boot/efi/linuxx64.efi.stub; \
    test -x /usr/sbin/bootc; \
    test -x /usr/sbin/systemd-run

RUN install -d -m 0755 /usr/libexec/prime /usr/lib/prime /usr/lib/bootc/install
COPY target/release/primed /usr/libexec/prime/primed
COPY image/systemd/primed.service /usr/lib/systemd/system/primed.service
COPY image/bootc/10-prime.toml /usr/lib/bootc/install/10-prime.toml

RUN set -eux; \
    chmod 0755 /usr/libexec/prime/primed; \
    chmod 0444 /usr/lib/bootc/install/10-prime.toml; \
    systemctl enable primed.service; \
    systemctl disable bootc-fetch-apply-updates.timer >/dev/null 2>&1 || true; \
    bootc install print-configuration > /tmp/prime-install-config.json; \
    python3 -c 'import json; c=json.load(open("/tmp/prime-install-config.json")); assert c.get("bootloader") == "systemd", c'; \
    rm -f /tmp/prime-install-config.json

RUN set -eux; \
    test -n "${PRIME_GENERATION_ID}"; \
    test -n "${PRIME_SOURCE_REVISION}"; \
    test -n "${PRIME_CREATED_AT}"; \
    test "${PRIME_BOOT_ATTEMPT_LIMIT}" -gt 0; \
    case "${PRIME_BASE_DIGEST}" in sha256:????????????????????????????????????????????????????????????????) ;; *) exit 1 ;; esac; \
    printf '%s\n' \
       '{' \
       '  "schema": "prime.generation-seed.v1",' \
       "  \"generation_id\": \"${PRIME_GENERATION_ID}\"," \
       '  "channel": "LAB",' \
       "  \"created_at\": \"${PRIME_CREATED_AT}\"," \
       "  \"source_revision\": \"${PRIME_SOURCE_REVISION}\"," \
       "  \"base_image_digest\": \"${PRIME_BASE_DIGEST}\"," \
       "  \"boot_attempt_limit\": ${PRIME_BOOT_ATTEMPT_LIMIT}" \
       '}' \
       > /usr/lib/prime/generation-seed.json; \
    chmod 0444 /usr/lib/prime/generation-seed.json; \
    python3 -c 'import json; json.load(open("/usr/lib/prime/generation-seed.json", "r", encoding="utf-8"))'; \
    test -x /usr/libexec/prime/primed; \
    test -L /etc/systemd/system/multi-user.target.wants/primed.service; \
    test ! -e /etc/systemd/system/timers.target.wants/bootc-fetch-apply-updates.timer; \
    bootc container lint --fatal-warnings

FROM rootfs AS split
RUN set -eux; \
    mkdir -p /kernel; \
    bootc container split-kernel-and-rootfs --rootfs / --output /kernel; \
    test "$(find /kernel -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1

FROM rootfs AS uki-tools
RUN --mount=type=bind,from=split,target=/target,ro \
    --mount=type=bind,from=split,source=/kernel,target=/kernel,ro \
    set -eux; \
    mkdir -p /out; \
    kver="$(find /kernel -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | head -n1)"; \
    test -n "${kver}"; \
    bootc container ukify \
      --rootfs /target \
      --kernel-dir "/kernel/${kver}" \
      -- \
      --output "/out/${kver}.efi"; \
    test -s "/out/${kver}.efi"

FROM split AS final
COPY --from=uki-tools /out/*.efi /boot/EFI/Linux/

RUN set -eux; \
    test "$(find /boot/EFI/Linux -maxdepth 1 -type f -name '*.efi' | wc -l)" -eq 1; \
    ! find /usr/lib/modules -type f \( -name vmlinuz -o -name initramfs.img \) -print -quit | grep -q .; \
    ! rpm -q bootupd >/dev/null 2>&1; \
    test -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi; \
    test -f /usr/lib/bootc/install/10-prime.toml; \
    bootc install print-configuration | python3 -c 'import json,sys; c=json.load(sys.stdin); assert c.get("bootloader") == "systemd", c'; \
    test -f /usr/lib/prime/generation-seed.json; \
    test -x /usr/libexec/prime/primed
