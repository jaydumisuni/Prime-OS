+    pub(crate) fn storage_status(&self) -> Result<Vec<String>, CoreClientError> {
+        let body = self.request("GET", "/v1/storage", None)?;
+        let projection: StorageProjection = serde_json::from_slice(&body)
+            .map_err(|error| CoreClientError::Json(error.to_string()))?;
+        let inventory = projection.inventory;
+        let totals = inventory.local_physical_totals;
+        let mut lines = vec![
+            "STORAGE".to_owned(),
+            format!(
+                "USED {} / TOTAL {}",
+                format_bytes(totals.used_bytes),
+                format_bytes(totals.total_bytes)
+            ),
+            format!("AVAILABLE {}", format_bytes(totals.available_bytes)),
+            format!("PRESSURE {}", pressure_name(inventory.pressure.state)),
+        ];
+        if inventory.reserve.policy_configured {
+            lines.push(match inventory.reserve.protected_rollback_recovery_bytes {
+                Some(bytes) => format!("RECOVERY RESERVE {}", format_bytes(bytes)),
+                None => "RECOVERY RESERVE UNKNOWN".to_owned(),
+            });
+        } else {
+            lines.push("RECOVERY RESERVE UNCONFIGURED".to_owned());
+        }
+        lines.push(format!(
+            "GENERATION {}",
+            truncate_text(&projection.generation_id, 24)
+        ));
+        for mount in inventory.mounts.iter().filter(|mount| {
+            matches!(
+                mount.filesystem_type.to_ascii_lowercase().as_str(),
+                "apfs" | "hfs" | "hfsplus" | "hfs+"
+            )
+        }).take(2) {
+            lines.push(format!(
+                "{} {} {}",
+                mount.filesystem_type.to_ascii_uppercase(),
+                truncate_text(&mount.mount_point, 18),
+                if mount.read_only { "READ-ONLY" } else { "MOUNTED" }
+            ));
+        }
+        Ok(lines)
+    }
