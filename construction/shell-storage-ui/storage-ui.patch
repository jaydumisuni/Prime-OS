+fn format_bytes(bytes: u64) -> String {
+    const GIB: u64 = 1024 * 1024 * 1024;
+    if bytes >= GIB {
+        format!("{}.{} GiB", bytes / GIB, ((bytes % GIB) * 10) / GIB)
+    } else {
+        const MIB: u64 = 1024 * 1024;
+        format!("{} MiB", bytes / MIB)
+    }
+}
+
+fn pressure_name(state: StoragePressureState) -> &'static str {
+    match state {
+        StoragePressureState::Unknown => "UNKNOWN",
+        StoragePressureState::Normal => "NORMAL",
+        StoragePressureState::Low => "LOW",
+        StoragePressureState::Critical => "CRITICAL",
+    }
+}
+
+fn truncate_text(value: &str, max_chars: usize) -> String {
+    if value.chars().count() <= max_chars {
+        value.to_owned()
+    } else {
+        value.chars().take(max_chars).collect()
+    }
+}
