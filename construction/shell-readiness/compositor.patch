+
+pub(crate) const BACKGROUND_NAMESPACE: &str = "prime.shell.background";
+pub(crate) const RAIL_NAMESPACE: &str = "prime.shell.rail";
+pub(crate) const SHELL_NOT_PROVEN_LIMITATION: &str =
+    "Prime Shell persistent baseline has not retired in a selected-CRTC frame";
+pub(crate) const SHELL_REVALIDATION_LIMITATION: &str =
+    "Prime Shell readiness requires revalidation with frame/output/session state";
+
+#[derive(Clone)]
+pub(crate) struct ShellBaselineIdentity {
+    background: WlSurface,
+    rail: WlSurface,
+}
+
+pub(crate) fn is_persistent_namespace(namespace: &str) -> bool {
+    matches!(namespace, BACKGROUND_NAMESPACE | RAIL_NAMESPACE)
+}
+
+pub(crate) fn persistent_baseline_renderable(
+    renderer: &mut GlesRenderer,
+    output: &Output,
+) -> Option<ShellBaselineIdentity> {
+    let map = layer_map_for_output(output);
+    let scale: Scale<f64> = output.current_scale().fractional_scale().into();
+    let mut backgrounds: Vec<(ClientId, WlSurface)> = Vec::new();
+    let mut rails: Vec<(ClientId, WlSurface)> = Vec::new();
+
+    for layer in map.layers() {
+        if !layer.alive() {
+            continue;
+        }
+
+        let expected_layer = match layer.namespace() {
+            BACKGROUND_NAMESPACE => Layer::Background,
+            RAIL_NAMESPACE => Layer::Top,
+            _ => continue,
+        };
+        if layer.layer() != expected_layer {
+            continue;
+        }
+
+        let Some(geometry) = map.layer_geometry(layer) else {
+            continue;
+        };
+        let location = geometry.loc.to_physical_precise_round(scale);
+        let elements = AsRenderElements::<GlesRenderer>::render_elements::<
+            WaylandSurfaceRenderElement<GlesRenderer>,
+        >(layer, renderer, location, scale, 1.0);
+        if elements.is_empty() {
+            continue;
+        }
+
+        let surface = layer.wl_surface().clone();
+        let Some(client) = surface.client() else {
+            continue;
+        };
+        let candidate = (client.id(), surface);
+        if layer.namespace() == BACKGROUND_NAMESPACE {
+            backgrounds.push(candidate);
+        } else {
+            rails.push(candidate);
+        }
+    }
+
+    for (client, background) in backgrounds {
+        if let Some((_, rail)) = rails.iter().find(|(rail_client, _)| rail_client == &client) {
+            return Some(ShellBaselineIdentity {
+                background,
+                rail: rail.clone(),
+            });
+        }
+    }
+
+    None
+}
+
+pub(crate) fn persistent_baseline_alive_mapped(
+    output: &Output,
+    identity: &ShellBaselineIdentity,
+) -> bool {
+    let map = layer_map_for_output(output);
+    let mut background_alive = false;
+    let mut rail_alive = false;
+
+    for layer in map.layers() {
+        if !layer.alive() {
+            continue;
+        }
+
+        if layer.namespace() == BACKGROUND_NAMESPACE
+            && layer.layer() == Layer::Background
+            && layer.wl_surface() == &identity.background
+        {
+            background_alive = true;
+        } else if layer.namespace() == RAIL_NAMESPACE
+            && layer.layer() == Layer::Top
+            && layer.wl_surface() == &identity.rail
+        {
+            rail_alive = true;
+        }
+    }
+
+    background_alive && rail_alive
+}
